#include <stdio.h>
#include <string.h>

int main() {
    char input[200];
    char result[200];
    int i = 0, j = 0;

    printf("Enter text: ");
    fgets(input, sizeof(input), stdin);

    while (input[i] != '\0') {

        if (input[i] == '\'') {
            i++;

            while (input[i] != '\0' && input[i] != '\'') {
                result[j++] = input[i++];
            }

            if (input[i] == '\'')
                i++;
            else {
                printf("Error: Unmatched single quote\n");
                return 1;
            }
        } else {
            result[j++] = input[i++];
        }
    }

    result[j] = '\0';

    printf("Parsed result: %s", result);

    return 0;
}



