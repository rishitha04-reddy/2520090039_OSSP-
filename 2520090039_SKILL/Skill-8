#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

#define MAX_INPUT 500
#define MAX_OUTPUT 1000

void expand_variables(char *input, char *output)
{
    int i = 0;
    int j = 0;

    while (input[i] != '\0' && j < MAX_OUTPUT - 1)
    {
        if (input[i] == '$')
        {
            i++;

            if (input[i] == '{')
            {
                i++;

                char var[100];
                int k = 0;

                while (input[i] != '\0' &&
                       input[i] != '}' &&
                       k < 99)
                {
                    var[k++] = input[i++];
                }

                var[k] = '\0';

                if (input[i] == '}')
                    i++;

                char *value = getenv(var);

                if (value != NULL)
                {
                    for (int x = 0; value[x] != '\0' &&
                         j < MAX_OUTPUT - 1; x++)
                    {
                        output[j++] = value[x];
                    }
                }
            }
            else
            {
                char var[100];
                int k = 0;

                while (input[i] != '\0' &&
                       (isalnum((unsigned char)input[i]) ||
                        input[i] == '_') &&
                       k < 99)
                {
                    var[k++] = input[i++];
                }

                var[k] = '\0';

                char *value = getenv(var);

                if (value != NULL)
                {
                    for (int x = 0; value[x] != '\0' &&
                         j < MAX_OUTPUT - 1; x++)
                    {
                        output[j++] = value[x];
                    }
                }
                else
                {
                    output[j++] = '$';

                    for (int x = 0; var[x] != '\0' &&
                         j < MAX_OUTPUT - 1; x++)
                    {
                        output[j++] = var[x];
                    }
                }
            }
        }
        else
        {
            output[j++] = input[i++];
        }
    }

    output[j] = '\0';
}

int main()
{
    char input[MAX_INPUT];
    char output[MAX_OUTPUT];

    printf("Skill-8 Variable Expansion\n");
    printf("Enter text: ");

    fgets(input, sizeof(input), stdin);

    input[strcspn(input, "\n")] = '\0';

    expand_variables(input, output);

    printf("Original : %s\n", input);
    printf("Expanded : %s\n", output);

    return 0;
}

