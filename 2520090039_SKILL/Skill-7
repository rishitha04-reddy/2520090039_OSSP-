#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

int main()
{
    pid_t pid;
    int status;

    printf("Parent Process Started\n");
    printf("Parent PID: %d\n", getpid());

    pid = fork();

    if (pid < 0)
    {
        perror("fork failed");
        return 1;
    }

    if (pid == 0)
    {
        printf("\nChild Process Started\n");
        printf("Child PID: %d\n", getpid());

        printf("Child is performing a task...\n");
        sleep(3);

        printf("Child Process Completed\n");
        exit(0);
    }
    else
    {
        printf("\nParent is waiting for Child...\n");

        waitpid(pid, &status, 0);

        if (WIFEXITED(status))
        {
            printf("\nChild PID %d terminated normally\n", pid);
            printf("Child Exit Status: %d\n",
                   WEXITSTATUS(status));
        }

        printf("Parent Process Resumed\n");
        printf("Parent Process Completed\n");
    }

    return 0;
}




