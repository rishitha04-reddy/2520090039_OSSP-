#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char input[200];
    int i = 0, words = 0;

    printf("Enter command: ");
    fgets(input, sizeof(input), stdin);

    while (isspace(input[i]))
        i++;

    if (input[i] == '\0') {
        printf("Empty command\n");
        return 0;
    }

    while (input[i] != '\0') {

        while (isspace(input[i]))
            i++;

        if (input[i] == '\0')
            break;

        if (input[i] == '|') {
            if (words == 0) {
                printf("Syntax Error: command expected before |\n");
                return 1;
            }

            words = 0;
            i++;
            continue;
        }

        while (input[i] != '\0' &&
               !isspace(input[i]) &&
               input[i] != '|')
            i++;

        words++;
    }

    if (words == 0) {
        printf("Syntax Error: command expected after |\n");
        return 1;
    }

    printf("Syntax Valid\n");
    printf("Parse Structure: COMMAND -> ARGUMENTS\n");

    return 0;
}
