#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char input[200];
    char token[50];
    int i = 0, j = 0;

    printf("Enter command: ");
    fgets(input, sizeof(input), stdin);

    printf("\nTokens:\n");

    while (input[i] != '\0') {

        if (isspace(input[i])) {
            i++;
            continue;
        }

        if (input[i] == '|' || input[i] == ';') {
            printf("DELIMITER: %c\n", input[i]);
            i++;
            continue;
        }

        j = 0;

        while (input[i] != '\0' &&
               !isspace(input[i]) &&
               input[i] != '|' &&
               input[i] != ';') {
            token[j++] = input[i++];
        }

        token[j] = '\0';

        if (j > 0)
            printf("WORD: %s\n", token);
    }

    return 0;
}


