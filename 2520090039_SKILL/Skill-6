#include <stdio.h>
#include <string.h>
#include <ctype.h>

void parse_input(char *input)
{
    char output[500];
    int i = 0, j = 0;
    int escaped = 0;

    while (input[i] != '\0' && j < 499)
    {
        if (escaped)
        {
            output[j++] = input[i];
            escaped = 0;
        }
        else if (input[i] == '\\')
        {
            escaped = 1;
        }
        else
        {
            output[j++] = input[i];
        }

        i++;
    }

    if (escaped)
    {
        output[j++] = '\\';
    }

    output[j] = '\0';

    printf("Original : %s\n", input);
    printf("Parsed   : %s\n", output);
}

int main()
{
    char input[500];

    printf("Skill-6 Escape Sequence Parser\n");
    printf("Enter input: ");

    fgets(input, sizeof(input), stdin);

    input[strcspn(input, "\n")] = '\0';

    parse_input(input);

    return 0;
} 



