#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <signal.h>
void signal_handler(int sig)
{
    if (sig == SIGINT)
        printf("\nSIGINT received: Interrupt signal\n");
    else if (sig == SIGTERM)
        printf("\nSIGTERM received: Termination signal\n");
    else if (sig == SIGUSR1)
        printf("\nSIGUSR1 received: User-defined signal\n");
}
int main()
{
    signal(SIGINT, signal_handler);
    signal(SIGTERM, signal_handler);
    signal(SIGUSR1, signal_handler);
    printf("Process ID: %d\n", getpid());
    printf("Waiting for signals...\n");
    while (1)
    {
        printf("Program is running...\n");
        sleep(3);
    }

    return 0;
}
