#include <stdio.h>
#include <unistd.h>
#include <stdlib.h>
#include <sys/wait.h>

int main()
{
    pid_t pid;

    pid=fork();

    if(pid==0)
    {
        printf("Child PID : %d\n",getpid());
        exit(0);
    }
    else
    {
        wait(NULL);
        printf("Parent collected child successfully.\n");
    }

    return 0;
}
