#include <stdio.h>
#include <stdlib.h>

int main()
{
    int *p;

    p = malloc(5 * sizeof(int));
    printf("malloc completed\n");
    free(p);

    p = calloc(5, sizeof(int));
    printf("calloc completed\n");

    p = realloc(p, 10 * sizeof(int));
    printf("realloc completed\n");

    free(p);
    printf("free completed\n");

    return 0;
}

